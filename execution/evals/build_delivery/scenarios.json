    {
      "id": "rollback_never_overwrites_a_gate_hold_arriving_before_the_clears",
      "why": "a task that is held at a gate before the rollback's clears keeps its hold (read before each clear, nothing written once it has moved), and the operator is told it is waiting at that gate and may need their decision, not that it was dispatched or needs no action",
      "path": "rollback_race",
      "race": {
        "when": "before",
        "status": "awaiting_approval",
        "reason": "Held for approval: high blast radius"
      },
      "expect": {
        "race_row": {
          "status": "awaiting_approval",
          "blocked_reason": "Held for approval: high blast radius"
        },
        "notification_contains": [
          "status is now awaiting_approval",
          "(read at",
          "waiting at a gate",
          "Held for approval",
          "may need your decision",
          "Apis did not change it"
        ],
        "notification_excludes": [
          "dispatched",
          "finished",
          "no action needed",
          "NOT held and NOT dispatched",
          "WILL re-dispatch"
