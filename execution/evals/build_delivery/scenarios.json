{
  "_comment": "Public-safe synthetic scenarios for a delivery-bearing Cicada build (ateles#1448 canary). Each drives the REAL launch code and the REAL run_skill to a stub codex that does a real git commit and push to a local bare remote and a stub gh pr create. Assertions are on effects in that world, not on arguments.",
  "scenarios": [
    {
      "id": "handoff_delivers_from_its_worktree",
      "why": "the swarm build handoff gives its child a worktree cwd, the two git roots and scoped network; the commit reaches the remote branch and the PR is on record",
      "path": "handoff",
      "expect": {
        "launches": 1,
        "child_in_worktree": true,
        "network": true,
        "add_dirs": 2,
        "sandbox": "workspace-write",
        "token_scoped": true,
        "commit_on_remote": true,
        "prs": 1,
        "result_ok": true,
        "result_names_recorded_pr": true,
        "claim_released": true
      }
    },
    {
      "id": "task_delivers_from_its_worktree",
      "why": "a task-routed Cicada cleared to deliver gets the same grants and delivers: commit on the remote branch, PR on record",
      "path": "task",
      "expect": {
        "launches": 1,
        "child_in_worktree": true,
        "network": true,
        "add_dirs": 2,
        "sandbox": "workspace-write",
        "token_scoped": true,
        "commit_on_remote": true,
        "prs": 1,
        "result_ok": true,
        "claim_released": true
      }
    },
    {
      "id": "task_with_an_explicit_repo_field_delivers",
      "why": "the dispatcher's one resolver reads `repo`, and an explicit field beats a different repository named in prose",
      "path": "task",
      "task": {
        "description": "Implement the spec. Follow the pattern in other/reference#9, then open a PR."
      },
      "expect": {
        "launches": 1,
        "child_in_worktree": true,
        "commit_on_remote": true,
        "prs": 1,
        "result_ok": true
      }
    },
    {
      "id": "handoff_launches_no_child_when_the_clone_is_the_wrong_repository",
      "why": "a clone whose origin is another repository is refused before any fetch, worktree, grant or token: no child, no worktree, nothing on the remote",
      "path": "handoff",
      "fault": "origin_mismatch",
      "expect": {
        "launches": 0,
        "worktree_dirs": 0,
        "commit_on_remote": false,
        "prs": 0,
        "result_ok": false,
        "claim_released": true,
        "operator_text_contains": [
          "NOT started",
          "origin that is not",
          "Before retrying",
          "https://github.com/eval-owner/eval-repo.git",
          "ATELES_BUILD_CLONES"
        ],
        "operator_text_excludes": [
          "spec may be incomplete",
          "approve the build",
          "opened NO PR"
        ]
      }
    },
    {
      "id": "task_launches_no_child_when_the_clone_is_the_wrong_repository",
      "why": "the same refusal on the task path, reported to the caller by reason",
      "path": "task",
      "fault": "origin_mismatch",
      "expect": {
        "launches": 0,
        "worktree_dirs": 0,
        "commit_on_remote": false,
        "prs": 0,
        "result_ok": false,
        "result_error_contains": "origin that is not",
        "operator_text_contains": [
          "build not started",
          "origin that is not",
          "Before retrying",
          "https://github.com/eval-owner/eval-repo.git",
          "ATELES_BUILD_CLONES"
        ]
      }
    },
    {
      "id": "handoff_launches_no_child_when_there_is_no_clone",
      "why": "no local clone, no worktree, so no child is launched",
      "path": "handoff",
      "fault": "no_clone",
      "expect": {
        "launches": 0,
        "worktree_dirs": 0,
        "prs": 0,
        "result_ok": false,
        "operator_text_contains": [
          "NOT started",
          "no local clone",
          "Before retrying",
          "clone https://github.com/eval-owner/eval-repo.git",
          "ATELES_BUILD_CLONES"
        ],
        "operator_text_excludes": [
          "spec may be incomplete",
          "approve the build",
          "opened NO PR"
        ]
      }
    },
    {
      "id": "task_launches_no_child_when_there_is_no_clone",
      "why": "no local clone, no worktree, so no child is launched; the reason is returned",
      "path": "task",
      "fault": "no_clone",
      "expect": {
        "launches": 0,
        "worktree_dirs": 0,
        "prs": 0,
        "result_ok": false,
        "result_error_contains": "no local clone",
        "operator_text_contains": [
          "build not started",
          "no local clone",
          "Before retrying",
          "clone https://github.com/eval-owner/eval-repo.git",
          "ATELES_BUILD_CLONES"
        ]
      }
    },
    {
      "id": "non_delivery_task_runs_unchanged",
      "why": "a local-edit task gets no worktree, no git roots and no network: the sandbox is widened for a dispatch that delivers and for nothing else",
      "path": "task",
      "task": {
        "action_type": "local_edit"
      },
      "expect": {
        "launches": 1,
        "child_in_daemon_cwd": true,
        "network": false,
        "add_dirs": 0,
        "sandbox": "workspace-write",
        "worktree_dirs": 0,
        "commit_on_remote": false,
        "prs": 0
      }
    },
    {
      "id": "tracking_task_mid_build_adds_no_launch_and_no_status_write",
      "why": "the task the build files for itself carries the run marker the child was given; it is not dispatched, and nothing is launched or written for it",
      "path": "mid_build",
      "child": {
        "hold": true
      },
      "events": [
        {
          "marker": true
        }
      ],
      "expect": {
        "run_id_in_prompt": true,
        "mid_launches": 1,
        "mid_status_writes": 0,
        "mid_spawns": 0,
        "final_spawns": [],
        "claim_released": true
      }
    },
    {
      "id": "independent_task_mid_build_is_deferred_then_run",
      "why": "a task about the same issue that is NOT the build's own is marked deferred ON THE TASK (with a readable reason) before it is acknowledged, then re-dispatched once when the build's claim is released; redelivery of its event changes nothing",
      "path": "mid_build",
      "child": {
        "hold": true
      },
      "events": [
        {
          "deliveries": 3
        }
      ],
      "expect": {
        "mid_launches": 1,
        "mid_status_writes": 1,
        "mid_spawns": 0,
        "final_spawns": [
          [
            "ent_eval_mid_0000",
            "build_released"
          ]
        ],
        "claim_released": true,
        "mid_deferred_on_the_task": [
          "ent_eval_mid_0000"
        ],
        "mid_status_values": [
          "pending"
        ]
      }
    },
    {
      "id": "control_task_for_a_different_issue_is_not_held",
      "why": "control: a task about another issue is dispatched immediately",
      "path": "mid_build",
      "child": {
        "hold": true
      },
      "events": [
        {
          "task": {
            "issue_number": 1449,
            "description": "Implement the spec in eval-owner/eval-repo#1449."
          }
        }
      ],
      "expect": {
        "mid_launches": 1,
        "mid_spawns": 1,
        "final_spawns": [
          [
            "ent_eval_mid_0000",
            "created"
          ]
        ],
        "claim_released": true
      }
    },
    {
      "id": "control_gate_override_is_not_held",
      "why": "control: an operator-approved release is dispatched even while a build runs",
      "path": "mid_build",
      "child": {
        "hold": true
      },
      "events": [
        {
          "override": true
        }
      ],
      "expect": {
        "mid_launches": 1,
        "mid_spawns": 1,
        "final_spawns": [
          [
            "ent_eval_mid_0000",
            "approved"
          ]
        ],
        "claim_released": true
      }
    },
    {
      "id": "claim_is_released_and_deferred_task_runs_after_a_failed_build",
      "why": "control: the build crashes; its claim is still released and the deferred task still runs",
      "path": "mid_build",
      "child": {
        "hold": true,
        "crash": true
      },
      "events": [
        {}
      ],
      "expect": {
        "mid_launches": 1,
        "mid_spawns": 0,
        "result_ok": false,
        "final_spawns": [
          [
            "ent_eval_mid_0000",
            "build_released"
          ]
        ],
        "claim_released": true,
        "mid_deferred_on_the_task": [
          "ent_eval_mid_0000"
        ]
      }
    },
    {
      "id": "restart_redispatches_a_deferred_task_through_the_gates",
      "why": "a task deferred behind a build survives losing ALL process state: after a restart with no creation event, the startup sweep finds it on the task itself and dispatches it through the normal gates",
      "path": "restart",
      "events": [
        {}
      ],
      "expect": {
        "marked_before_restart": [
          "ent_eval_rst_0000"
        ],
        "spawns_after_wipe": 0,
        "final_spawns": [
          [
            "ent_eval_rst_0000",
            "build_released"
          ]
        ],
        "restart_statuses": {
          "ent_eval_rst_0000": [
            "routed",
            "executing"
          ]
        }
      }
    },
    {
      "id": "restart_does_not_run_a_deferred_task_the_build_completed",
      "why": "control: the build finished the deferred task while Apis was down; it is not run again",
      "path": "restart",
      "events": [
        {}
      ],
      "while_down": {
        "ent_eval_rst_0000": "complete"
      },
      "expect": {
        "marked_before_restart": [
          "ent_eval_rst_0000"
        ],
        "final_spawns": [],
        "restart_status_not": {
          "ent_eval_rst_0000": [
            "routed",
            "executing"
          ]
        }
      }
    },
    {
      "id": "restart_duplicate_delivery_does_not_double_dispatch",
      "why": "control: two startup sweeps at once and an SSE redelivery of the task's creation dispatch it exactly once",
      "path": "restart",
      "events": [
        {}
      ],
      "startup_sweeps": 2,
      "redelivered_creates": 1,
      "expect": {
        "marked_before_restart": [
          "ent_eval_rst_0000"
        ],
        "final_spawns": [
          [
            "ent_eval_rst_0000",
            "build_released"
          ]
        ]
      }
    },
    {
      "id": "restart_surfaces_a_deferred_task_it_cannot_re_read",
      "why": "a deferred task the sweep cannot read is not skipped silently: the operator is told the task and the next action, and nothing is dispatched",
      "path": "restart",
      "events": [
        {}
      ],
      "while_down": {
        "ent_eval_rst_0000": "unreadable"
      },
      "expect": {
        "marked_before_restart": [
          "ent_eval_rst_0000"
        ],
        "final_spawns": [],
        "notification_contains": [
          "ent_eval_rst_0000",
          "could not be re-read",
          "re-dispatch it by hand"
        ]
      }
    },
    {
      "id": "handoff_launches_no_child_when_the_worktree_remote_is_wrong_case_1",
      "why": "the worktree made from a verified clone is verified on its own before it is returned: no child, no token resolved, nothing left behind, and the operator is told the prerequisite",
      "path": "handoff",
      "fault": "worktree_remote_1",
      "expect": {
        "launches": 0,
        "worktree_dirs": 0,
        "commit_on_remote": false,
        "prs": 0,
        "result_ok": false,
        "token_requests": 0,
        "operator_text_contains": [
          "NOT started",
          "worktree",
          "verify the worktree's effective remote configuration",
          "Before retrying"
        ],
        "operator_text_excludes": [
          "spec may be incomplete",
          "approve the build",
          "opened NO PR"
        ],
        "claim_released": true
      }
    },
    {
      "id": "handoff_launches_no_child_when_the_worktree_remote_is_wrong_case_2",
      "why": "the worktree made from a verified clone is verified on its own before it is returned: no child, no token resolved, nothing left behind, and the operator is told the prerequisite",
      "path": "handoff",
      "fault": "worktree_remote_2",
      "expect": {
        "launches": 0,
        "worktree_dirs": 0,
        "commit_on_remote": false,
        "prs": 0,
        "result_ok": false,
        "token_requests": 0,
        "operator_text_contains": [
          "NOT started",
          "worktree",
          "verify the worktree's effective remote configuration",
          "Before retrying"
        ],
        "operator_text_excludes": [
          "spec may be incomplete",
          "approve the build",
          "opened NO PR"
        ],
        "claim_released": true
      }
    },
    {
      "id": "task_launches_no_child_when_the_worktree_remote_is_wrong_case_1",
      "why": "the worktree made from a verified clone is verified on its own before it is returned: no child, no token resolved, nothing left behind, and the operator is told the prerequisite",
      "path": "task",
      "fault": "worktree_remote_1",
      "expect": {
        "launches": 0,
        "worktree_dirs": 0,
        "commit_on_remote": false,
        "prs": 0,
        "result_ok": false,
        "token_requests": 0,
        "operator_text_contains": [
          "build not started",
          "worktree",
          "verify the worktree's effective remote configuration",
          "Before retrying"
        ],
        "claim_released": true
      }
    },
    {
      "id": "task_launches_no_child_when_the_worktree_remote_is_wrong_case_2",
      "why": "the worktree made from a verified clone is verified on its own before it is returned: no child, no token resolved, nothing left behind, and the operator is told the prerequisite",
      "path": "task",
      "fault": "worktree_remote_2",
      "expect": {
        "launches": 0,
        "worktree_dirs": 0,
        "commit_on_remote": false,
        "prs": 0,
        "result_ok": false,
        "token_requests": 0,
        "operator_text_contains": [
          "build not started",
          "worktree",
          "verify the worktree's effective remote configuration",
          "Before retrying"
        ],
        "claim_released": true
      }
    },
    {
      "id": "restart_recovers_a_deferral_whose_first_write_dropped_a_field",
      "why": "a deferral write that succeeded but did not persist a field is caught by reading the task back and rewritten; the task is then recoverable across a restart",
      "path": "restart",
      "events": [
        {}
      ],
      "store_faults": {
        "dispatch_context": [
          "omit",
          1
        ]
      },
      "expect": {
        "marked_before_restart": [
          "ent_eval_rst_0000"
        ],
        "final_spawns": [
          [
            "ent_eval_rst_0000",
            "build_released"
          ]
        ],
        "restart_statuses": {
          "ent_eval_rst_0000": [
            "routed",
            "executing"
          ]
        }
      }
    },
    {
      "id": "deferral_that_never_persists_is_warned_not_acknowledged",
      "why": "a deferral whose fields never persist is neither held in memory nor dispatched: the task is left as it was, the operator is told once with the task, the fields and the next action, and after a restart nothing pretends it was recorded",
      "path": "restart",
      "events": [
        {}
      ],
      "store_faults": {
        "disposition": [
          "mismatch",
          99
        ]
      },
      "expect": {
        "not_marked_before_restart": [
          "ent_eval_rst_0000"
        ],
        "final_spawns": [],
        "warning_before_restart_contains": [
          "ent_eval_rst_0000",
          "could not record a deferral",
          "NOT held and NOT dispatched",
          "by hand when the build"
        ],
        "spawns_after_wipe": 0
      }
    },
    {
      "id": "restart_sweep_reaches_every_marked_task_past_broken_records",
      "why": "more than 50 deferred tasks, local-edit ones included, with unreadable and malformed records sorted BEFORE the valid ones: every valid task reaches the gates from one startup sweep and its continuation, with no creation event, unrelated release or restart; broken records are announced once each; repeated sweeps change nothing",
      "path": "sweep_scale",
      "scale": {
        "valid_local": 52,
        "valid_pr": 6,
        "unreadable": 3,
        "garbled": 3,
        "missing_context": 3,
        "backlog": 4,
        "repeat_sweeps": 2
      },
      "expect": {
        "scale": {
          "spawned": 52
        }
      }
    },
    {
      "id": "queued_deferred_task_is_re_validated_when_its_slot_comes",
      "why": "tasks queued behind the three busy recovery slots are read again when their turn comes: one completed, cancelled or re-marked while waiting is NOT dispatched and gets no status write (quietly); one whose context became missing or malformed, or that became unreadable, is reported once (and not again by a later sweep), not dispatched and not changed; one still deferred is dispatched from the fresh read",
      "path": "slot_wait",
      "queued": [
        "completed",
        "cancelled",
        "remarked",
        "still_deferred",
        "unreadable",
        "context_missing",
        "context_garbled"
      ],
      "expect": {
        "slot_wait": {
          "not_dispatched": [
            "completed",
            "cancelled",
            "remarked",
            "unreadable",
            "context_missing",
            "context_garbled"
          ],
          "dispatched_from_fresh_read": {
            "still_deferred": "as re-read at its turn"
          },
          "announced_once": [
            "unreadable",
            "context_missing",
            "context_garbled"
          ],
          "task_untouched_by_apis": [
            "context_missing",
            "context_garbled",
            "remarked"
          ],
          "announced_at_its_turn": [
            "unreadable",
            "context_missing",
            "context_garbled"
          ]
        }
      }
    },
    {
      "id": "unrecordable_deferral_whose_marker_cannot_be_cleared_is_announced_truthfully_and_dispatched_once",
      "why": "the double fault: the deferral cannot be confirmed AND the commit marker (the reason) cannot be cleared, so a complete marker remains. The notice says Apis WILL re-dispatch it (and names the fields), and after the build ends it is dispatched exactly once: the notice and the behaviour agree",
      "path": "restart",
      "events": [
        {}
      ],
      "fail_next_reads": 2,
      "store_policy": {
        "blocked_reason": "reject_clear"
      },
      "expect": {
        "warning_before_restart_contains": [
          "ent_eval_rst_0000",
          "could not clear its marker",
          "WILL re-dispatch",
          "unless you cancel the task",
          "blocked_reason"
        ],
        "final_spawns": [
          [
            "ent_eval_rst_0000",
            "build_released"
          ]
        ]
      }
    },
    {
      "id": "unrecordable_deferral_whose_context_cannot_be_cleared_is_never_dispatched",
      "why": "the reason (commit marker) is cleared first and verified by read-back, so a marker left by a later failed clear does not qualify: the notice says NOT held and NOT dispatched, the sweep reports the leftover once as unresolvable, and nothing is dispatched",
      "path": "restart",
      "events": [
        {}
      ],
      "fail_next_reads": 2,
      "store_policy": {
        "dispatch_context": "reject_clear"
      },
      "expect": {
        "warning_before_restart_contains": [
          "NOT held and NOT dispatched",
          "by hand when the build"
        ],
        "final_spawns": [],
        "notification_counts": {
          "does not say which build": 1
        }
      }
    },
    {
      "id": "partially_written_deferral_without_its_reason_is_never_dispatched",
      "why": "the reason is written last as the commit marker: when it never lands, the other fields are a half-written record that the sweep reports once and never dispatches, even if the rollback also fails",
      "path": "restart",
      "events": [
        {}
      ],
      "store_policy": {
        "blocked_reason": "drop_write",
        "dispatch_context": "reject_clear"
      },
      "expect": {
        "warning_before_restart_contains": [
          "NOT held and NOT dispatched"
        ],
        "final_spawns": [],
        "notification_counts": {
          "does not say which build": 1
        }
      }
    }
  ]
}
