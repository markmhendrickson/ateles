    {
      "id": "tracked_unconfirmed_delete_keeps_capacity_reserved",
      "description": "The reaper's delete is acknowledged but the machine keeps running: its reservation is kept (marked unconfirmed, not charged as settled), so with one concurrent slot the new dispatch is deferred with cooled_until.",
      "settings": {
        "APIS_FLY_MAX_CONCURRENT": "1"
      },
      "identity": "key",
      "github_app": "configured",
      "seed": [
        {
          "machine": "m-stuck",
          "state": "sticky",
          "age": 5000,
          "window": 1920
        }
      ],
      "fly": {
        "wait": "ok",
        "record": null
      },
      "args": [
        "--runner",
        "fly",
        "--github-delivery",
        "--repository",
        "owner/repo"
      ],
      "expect": {
        "exit": 1,
        "ok": false,
        "reason_contains": "concurrency",
        "cooled_until": true,
        "local_cli_ran": false,
        "seed_settled": false,
        "machines_created": 0,
        "in_flight_at_least": 1,
        "revoked_all_minted": true
      }
    },
    {
      "id": "opted_in_lost_create_unconfirmed_no_local_replay",
      "description": "Opted-in class, local fallback on (the default): the create response is lost and the machine survives every termination attempt. The task must not run locally; the result is a failure that names the remote run as unknown and unconfirmed, and its reservation is kept for the reaper.",
      "settings": {
        "APIS_FLY_RUNNER_CLASSES": "carry_forward_check"
      },
      "identity": "key",
      "github_app": "configured",
      "args": [
        "--action-class",
        "carry_forward_check",
        "--model",
        "eval-model",
        "--github-delivery",
        "--github-token-env",
        "EVAL_LOCAL_SCOPED_GH",
        "--repository",
        "owner/repo"
      ],
      "fly": {
        "wait": "ok",
        "record": null,
        "create": "lost",
        "delete_ineffective": true
      },
      "expect": {
        "exit": 1,
        "ok": false,
        "reason_contains": "Not retried locally",
        "local_cli_ran": false,
        "remote_outcome_unknown": true,
        "remote_machine_state": "unconfirmed",
        "in_flight_at_least": 1,
        "revoked_all_minted": true
      }
    },
    {
      "id": "opted_in_lost_create_terminated_no_local_replay",
