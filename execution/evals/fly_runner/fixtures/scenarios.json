      "fly": {
        "wait": "ok",
        "record": null,
        "create": "lost"
      },
      "expect": {
        "exit": 1,
        "ok": false,
        "reason_contains": "Not retried locally",
        "local_cli_ran": false,
        "remote_outcome_unknown": true,
        "remote_machine_state": "terminated",
        "in_flight_after": 0,
