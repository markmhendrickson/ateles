{
  "_comment": "Public-safe offline agent CLI scenarios; real dispatch/provider argv with synthetic external edges.",
  "scenarios": [
    {
      "id": "omitted_selectors_preserve_default",
      "why": "Omission retains existing provider-default behavior.",
      "args": [
        "--provider",
        "codex"
      ],
      "expect": {
        "exit_code": 0,
        "launches": 1,
        "models": [
          null
        ]
      }
    },
    {
      "id": "explicit_sol_reaches_guarded_child",
      "why": "An explicit valid model reaches the real provider argv.",
      "args": [
        "--provider",
        "codex",
        "--model",
        "gpt-6-sol"
      ],
      "expect": {
        "exit_code": 0,
        "launches": 1,
        "models": [
          "gpt-6-sol"
        ]
      }
    },
    {
      "id": "explicit_terra_overrides_class",
      "why": "Explicit selection retains precedence over the existing action-class resolver.",
      "args": [
        "--provider",
        "codex",
        "--model",
        "gpt-5.6-terra",
        "--action-class",
        "lens_review:arch"
      ],
      "expect": {
        "exit_code": 0,
        "launches": 1,
        "models": [
          "gpt-5.6-terra"
        ]
      }
    },
    {
      "id": "action_class_resolves_each_comparison_provider",
      "why": "Comparison uses the existing binding independently for each provider.",
      "args": [
        "--compare",
        "codex,cursor",
        "--action-class",
        "lens_review:arch"
      ],
      "expect": {
        "exit_code": 0,
        "launches": 2,
        "models": [
          "gpt-6-sol",
          "gpt-5.6-sol-high"
        ]
      }
    },
    {
      "id": "omitted_selectors_comparison_preserves_defaults",
      "why": "Comparison retains default selection for each provider when selectors are omitted.",
      "args": [
        "--compare",
        "codex,cursor"
      ],
      "expect": {
        "exit_code": 0,
        "launches": 2,
        "models": [
          null,
          null
        ]
      }
    },
    {
      "id": "dry_run_default",
