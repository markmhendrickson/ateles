{
  "description": "Ateles live rule delivery and action/turn guards for Codex. Rule content remains canonical in Neotoma agent_policy; these hooks only render or enforce it.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/session_rule_index.py\"",
            "timeout": 30,
            "statusMessage": "Loading live Ateles rules",
            "additionalContextLimit": 4000
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/reporting_contract.py\"",
            "timeout": 30,
            "statusMessage": "Loading the operator reporting contract",
            "additionalContextLimit": 2000
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/session_rule_index.py\"",
            "timeout": 30,
            "statusMessage": "Loading live Ateles rules for subagent",
            "additionalContextLimit": 4000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/session_rule_delivery.py\"",
            "timeout": 30,
            "statusMessage": "Checking for updated Ateles rules",
            "additionalContextLimit": 4000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/report_quality_gate.py\"",
            "timeout": 30,
            "statusMessage": "Checking operator-altitude reporting"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/decision_shape_gate.py\"",
            "timeout": 30,
            "statusMessage": "Checking the turn-ending decision contract"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/sibling_repo_worktree_guard.py\"",
            "timeout": 30,
            "statusMessage": "Checking repository isolation"
          }
        ]
      },
      {
        "matcher": "^(Bash|apply_patch|mcp__mcpsrv_neotoma__correct|mcp__mcpsrv_neotoma__store)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/rule_injection_gate.py\"",
            "timeout": 30,
            "statusMessage": "Checking point-of-use rules"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/gmail_send_gate.py\"",
            "timeout": 30,
            "statusMessage": "Checking outward-send approval"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/git_stash_guard.py\"",
            "timeout": 30,
            "statusMessage": "Protecting the shared stash stack"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/gh_identity_guard.py\"",
            "timeout": 30,
            "statusMessage": "Checking GitHub identity"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/decision_shape_gate.py\"",
            "timeout": 30,
            "statusMessage": "Checking the subagent decision contract"
          }
        ]
      }
    ]
  }
}
